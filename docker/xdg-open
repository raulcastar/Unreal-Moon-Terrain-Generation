#!/usr/bin/env python3
"""
xdg-open for Terrain Studio's container ("Open output folder"). There is no
desktop in here, so the folder (or file) is shown by the host's file manager
through the session bus, org.freedesktop.FileManager1 (Dolphin, Nautilus...),
which run_terrain_studio_docker.sh mounts in gui mode.
"""
import os
import subprocess
import sys
import urllib.parse

target = os.path.abspath(sys.argv[1])
uri = "file://" + urllib.parse.quote(target)
method = "ShowFolders" if os.path.isdir(target) else "ShowItems"
sys.exit(subprocess.call(
    ["dbus-send", "--session", "--print-reply", "--dest=org.freedesktop.FileManager1",
     "/org/freedesktop/FileManager1", f"org.freedesktop.FileManager1.{method}",
     f"array:string:{uri}", "string:"], stdout=subprocess.DEVNULL))
